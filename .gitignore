# Virtual envs / caches
.venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Runtime data: SQLite DB, browser profile, screenshots, probe junk
data/
logs/
*.part
*.log
.playwright-mcp/

# CVs are personal data kept in the local CV folder — not for the repo
CV_collection/

# Per-application drafts (statements, cover letters, enquiry emails) carry
# personal contact details — keep them local next to the CVs
applications/

# Secrets — never commit: real config with API keys, Google OAuth files
config.toml
secrets/
.env

# OS noise
Thumbs.db
.DS_Store
